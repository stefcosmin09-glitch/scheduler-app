# Copy to .env and fill in. The app refuses to start without SECRET_KEY,
# because a committed default would sign every session and CSRF token with a
# value published on GitHub.
#
#   cp .env.example .env
#
# Generate a key with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Required. Without it the app exits with an error instead of starting.
SECRET_KEY=

# SQLite is fine locally. In production this is a Railway Postgres URL, and
# config.py rewrites postgres:// to postgresql+psycopg2:// for you.
DATABASE_URL=sqlite:///scheduler.db

# Where the app sends users back to after Stripe and calendar links.
APP_URL=http://localhost:5000

# Leave closed until you are ready to let people in.
SIGNUP_OPEN=0

# Email, through Resend. Leave both blank to skip sending.
RESEND_API_KEY=
MAIL_DEFAULT_SENDER=
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# Stripe. Required for the Pro plan and the payment link on invoices.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Receipt photo OCR. Either provider works; leave both blank to disable it.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
OPENAI_API_KEY=

# Optional: a second database URL used by the backup script.
BACKUP_DATABASE_URL=
